# Supabase: without these the app runs on the bundled songs
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron routes (/api/ping, /api/push/send) check this bearer token
CRON_SECRET=

# Web Push for the morning verse
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
