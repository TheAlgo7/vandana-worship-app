{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 9 */5 * *"
    },
    {
      "path": "/api/push/send",
      "schedule": "30 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
